{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kvisko",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"],
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "kvisko",
    // Replace with the ID returned by `npx wrangler d1 create kvisko` before deployment.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "QUIZ_LENGTH": "30",
    "SESSION_TTL_DAYS": "30"
  },
  "triggers": { "crons": ["0 3 * * *"] }
}
